---
// Flag of Texas, 2:3. Sized in em so it scales with the surrounding text.
const { class: className = "" } = Astro.props;
---

<svg
  viewBox="0 0 3 2"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label="Texas flag"
  class={className}
>
  <rect width="3" height="2" fill="#BF0A30"></rect>
  <rect width="3" height="1" fill="#FFFFFF"></rect>
  <rect width="1" height="2" fill="#002868"></rect>
  <polygon points="0.500,0.640 0.581,0.889 0.842,0.889 0.631,1.042 0.712,1.291 0.500,1.138 0.288,1.291 0.369,1.042 0.158,0.889 0.419,0.889" fill="#FFFFFF"></polygon>
</svg>
