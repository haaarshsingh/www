<script>
  // Defer fetching/playback for offscreen videos so the page becomes interactive
  // quickly even though the bento has 14+ looping videos. Each <video> ships
  // with preload="metadata" so the browser only fetches headers up front; the
  // observer below upgrades preload + kicks off play() once a card is near the
  // viewport, and pauses again when it scrolls far away so background tabs
  // and long sessions don't burn CPU/battery on invisible loops.
  const setupLazyVideos = () => {
    const videos =
      document.querySelectorAll<HTMLVideoElement>("video.lazy-video");
    if (videos.length === 0) return;

    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;
    if (prefersReducedMotion) {
      videos.forEach((video) => {
        video.removeAttribute("autoplay");
        video.pause();
      });
      return;
    }

    if (!("IntersectionObserver" in window)) {
      videos.forEach((video) => {
        video.preload = "auto";
        void video.play().catch(() => {});
      });
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const video = entry.target as HTMLVideoElement;
          if (entry.isIntersecting) {
            if (video.preload !== "auto") {
              video.preload = "auto";
              video.load();
            }
            void video.play().catch(() => {});
          } else {
            video.pause();
          }
        });
      },
      {
        rootMargin: "200px 0px",
        threshold: 0.01,
      },
    );

    videos.forEach((video) => observer.observe(video));

    // Chrome evicts pages from bfcache once a tab has received >~64MB on
    // active network connections (Pause()'ing a <video> doesn't necessarily
    // cancel its in-flight fetch). Downgrading preload + calling load() on
    // pagehide releases the underlying request so the page is bfcache-eligible
    // again and we don't burn data while the tab is hidden.
    const suspendAll = () => {
      videos.forEach((video) => {
        if (!video.paused) video.pause();
        if (video.preload !== "metadata") {
          video.preload = "metadata";
        }
      });
    };

    const resumeVisible = () => {
      videos.forEach((video) => {
        const rect = video.getBoundingClientRect();
        const inView =
          rect.bottom > -200 &&
          rect.top < window.innerHeight + 200 &&
          rect.right > 0 &&
          rect.left < window.innerWidth;
        if (inView) {
          if (video.preload !== "auto") {
            video.preload = "auto";
            video.load();
          }
          void video.play().catch(() => {});
        }
      });
    };

    document.addEventListener("visibilitychange", () => {
      if (document.visibilityState === "hidden") {
        suspendAll();
      } else {
        resumeVisible();
      }
    });

    window.addEventListener("pagehide", suspendAll);
    window.addEventListener("pageshow", (event) => {
      if (event.persisted) resumeVisible();
    });
  };

  setupLazyVideos();
</script>
